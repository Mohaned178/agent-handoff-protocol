{
  "name": "agent-handoff-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Explicit, verifiable and measurable handoffs between AI coding agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohaned178/agent-handoff-protocol.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ahp": "bin/ahp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas": "node scripts/export-schemas.ts"
  },
  "dependencies": {
    "execa": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
