{
  "name": "@mohaned178/ahp",
  "version": "0.1.0",
  "description": "Explicit, verifiable and measurable handoffs between AI coding agents",
  "keywords": [
    "ai",
    "coding-agents",
    "claude-code",
    "codex",
    "opencode",
    "handoff",
    "verification",
    "cli",
    "agents",
    "acp"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/Mohaned178/agent-handoff-protocol#readme",
  "bugs": {
    "url": "https://github.com/Mohaned178/agent-handoff-protocol/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohaned178/agent-handoff-protocol.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ahp": "bin/ahp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas": "node scripts/export-schemas.ts",
    "conformance": "node scripts/conformance.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "execa": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
