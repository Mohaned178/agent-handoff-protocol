{
  "prompt": "Show me what is in src/config.js.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a text file from the project.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path relative to the project root."
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get the current weather for a city.",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "The city's name."
            },
            "unit": {
              "type": "string",
              "enum": [
                "celsius",
                "fahrenheit"
              ]
            }
          },
          "required": [
            "city"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_code",
        "description": "Search the project's source for a text.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "directory": {
              "type": "string",
              "description": "Where to search, relative to the project root."
            }
          },
          "required": [
            "query"
          ]
        }
      }
    }
  ],
  "expect": {
    "name": "read_file",
    "arguments": {
      "path": "src/config.js"
    }
  }
}
