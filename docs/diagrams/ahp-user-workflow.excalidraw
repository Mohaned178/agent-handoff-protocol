      "fillStyle": "solid",
      "strokeWidth": 1,
      "roundness": null,
      "text": "retry: a new attempt in a new workspace\nfrom the step’s base commit\nnew handoff revision carries the failing\nevidence (hidden-test output left out)\nbudget counted from the ledger (default 2)\nbudget spent: optional reroute to the step’s\nalternative agent, else the step fails",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "retry: a new attempt in a new workspace\nfrom the step’s base commit\nnew handoff revision carries the failing\nevidence (hidden-test output left out)\nbudget counted from the ledger (default 2)\nbudget spent: optional reroute to the step’s\nalternative agent, else the step fails",
      "autoResize": true,
      "lineHeight": 1.25
    },
