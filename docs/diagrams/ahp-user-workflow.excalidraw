      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roundness": null,
      "text": "transient (rate limit, outage):\nretry after an exponential backoff\ninconclusive (the validator could not run):\nre-run once; if still inconclusive the step\nfails and is surfaced to you to fix\nconfig_auth and rejected are never retried",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "transient (rate limit, outage):\nretry after an exponential backoff\ninconclusive (the validator could not run):\nre-run once; if still inconclusive the step\nfails and is surfaced to you to fix\nconfig_auth and rejected are never retried",
      "autoResize": true,
      "lineHeight": 1.25
