{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0",
      "description": "Version of this schema."
    },
    "handoffId": {
      "type": "string",
      "pattern": "^hnd_[a-z0-9]+$",
      "description": "Identifies the handoff across its revisions."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "1 for the first revision; a change is always a new revision."
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ],
      "description": "The revision this one replaces: null for revision 1, otherwise revision - 1."
    },
    "contextId": {
      "type": "string",
      "pattern": "^run_[a-z0-9]+$",
      "description": "A2A `contextId`: the run the handoff belongs to."
    },
    "from": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stepId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "attemptId": {
              "type": "string",
              "pattern": "^att_[a-z0-9]+$"
            }
          },
          "required": [
            "stepId",
            "attemptId"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The verified attempt whose result is handed on; null for the first step."
    },
    "to": {
      "type": "object",
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "requestedModel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "As requested; never what the tool reports."
        }
      },
      "required": [
        "stepId",
        "adapter",
        "requestedModel"
      ],
      "additionalProperties": false,
      "description": "The recipient step and its coding agent."
    },
    "base": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "commit"
      ],
      "additionalProperties": false,
      "description": "The commit the recipient's workspace starts from, and the commit artifacts are read from."
    },
    "contract": {
      "type": "object",
      "properties": {
        "instructions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "What the step is to do, as the workflow states it."
        },
        "acceptance": {
          "type": "object",
          "properties": {
            "verificationCommand": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "requiredOutputFields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "description": "Fields the attempt must report to pass."
            }
          },
          "required": [
            "verificationCommand",
            "requiredOutputFields"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "instructions",
        "acceptance"
      ],
      "additionalProperties": false,
      "description": "The recipient step's contract. AHP extension: acceptance criteria."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "read_only"
              },
              "require": {
                "type": "string",
                "enum": [
                  "enforced_by_tool",
                  "cooperative",
                  "none"
                ],
                "description": "The weakest enforcement level the recipient's adapter may apply this at on the running operating system; a weaker one rejects the handoff."
              }
            },
            "required": [
              "kind",
              "require"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "write_scope"
              },
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1024,
                  "pattern": "^(?!\\.[gG][iI][tT](?:\\/|$))(?!\\.{1,2}(?:\\/|$))[^/\\\\:*?\"<>|\\u0000-\\u001f]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\:*?\"<>|\\u0000-\\u001f]+)*$",
                  "description": "Relative to the repository root, written with forward slashes: no leading or trailing slash, no `.` or `..` segments, nothing under `.git`, and none of the characters \\ : * ? \" < > | or control characters."
                },
                "description": "The only paths the agent may change, each a file or a directory with everything under it."
              },
              "require": {
                "type": "string",
                "enum": [
                  "enforced_by_tool",
                  "cooperative",
                  "none"
                ],
                "description": "The weakest enforcement level the recipient's adapter may apply this at on the running operating system; a weaker one rejects the handoff."
              }
            },
            "required": [
              "kind",
              "paths",
              "require"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "no_external_actions"
              },
              "require": {
                "type": "string",
                "enum": [
                  "enforced_by_tool",
                  "cooperative",
                  "none"
                ],
                "description": "The weakest enforcement level the recipient's adapter may apply this at on the running operating system; a weaker one rejects the handoff."
              }
            },
            "required": [
              "kind",
              "require"
            ],
            "additionalProperties": false
          }
        ],
        "description": "A capability the recipient's adapter is to apply to the coding agent's tool use. `enforced_by_tool` means the tool blocks what it forbids; `cooperative` means the agent is only asked, which is not enforcement. AHP extension: no A2A counterpart."
      },
      "description": "What the recipient's adapter is to apply, at least at each request's required level. Every agent step carries `no_external_actions`."
    },
    "network": {
      "type": "object",
      "properties": {
        "stance": {
          "type": "string",
          "enum": [
            "deny",
            "package_registries"
          ],
          "description": "The network access the agent's own tool use has, never its connection to its model provider."
        },
        "require": {
          "type": "string",
          "enum": [
            "enforced_by_tool",
            "cooperative",
            "none"
          ],
          "description": "The weakest enforcement level the recipient's adapter may apply this at on the running operating system; a weaker one rejects the handoff."
        }
      },
      "required": [
        "stance",
        "require"
      ],
      "additionalProperties": false,
      "description": "The step's network stance. AHP extension: no A2A counterpart."
    },
    "context": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "description": "The previous step's required output fields (for example decisions, constraints, summary)."
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false,
      "description": "What earlier steps decided and learned."
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(?!\\.[gG][iI][tT](?:\\/|$))(?!\\.{1,2}(?:\\/|$))[^/\\\\:*?\"<>|\\u0000-\\u001f]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\:*?\"<>|\\u0000-\\u001f]+)*$",
            "description": "Relative to the repository root, written with forward slashes: no leading or trailing slash, no `.` or `..` segments, nothing under `.git`, and none of the characters \\ : * ? \" < > | or control characters."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 (lowercase hex) of the file's committed content, never of working-tree bytes (ADR 0005)."
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "description": "A file passed by reference, read from the handoff's base commit. AHP extension: A2A artifacts carry no content hash."
      },
      "description": "Files from the previous step, passed by reference."
    },
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "test_output"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exitCode": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "signal": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "output": {
                "description": "The end of the command's output, or null when it is withheld because the command runs hidden tests, whose output must not reach the agent.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "truncated": {
                "type": "boolean",
                "description": "True when `output` holds only the end of a longer output."
              }
            },
            "required": [
              "kind",
              "command",
              "exitCode",
              "signal",
              "output",
              "truncated"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "required_output_fields"
              },
              "missing": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "description": "The required output fields the attempt did not report, or reported blank."
              }
            },
            "required": [
              "kind",
              "missing"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "review_findings"
              },
              "reviewStepId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "description": "The review step that sent this step back."
              },
              "findings": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "What the review found, in its words."
              }
            },
            "required": [
              "kind",
              "reviewStepId",
              "findings"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "approval_rejected"
              },
              "gateStepId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "description": "The approval gate where a person rejected this step's result."
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Why the approver rejected it, in their words."
              }
            },
            "required": [
              "kind",
              "gateStepId",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "review_verdict"
              },
              "reported": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "What the review reported as its verdict."
              },
              "allowed": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "approved",
                    "changes_requested"
                  ]
                },
                "description": "The verdicts a review may report."
              }
            },
            "required": [
              "kind",
              "reported",
              "allowed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "protected_paths"
              },
              "violations": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "change": {
                      "type": "string",
                      "enum": [
                        "added",
                        "modified",
                        "deleted"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "change"
                  ],
                  "additionalProperties": false
                },
                "description": "The paths the attempt changed that it must not change. The other protected paths are not listed."
              },
              "truncated": {
                "type": "boolean",
                "description": "True when `violations` lists only the first of more."
              }
            },
            "required": [
              "kind",
              "violations",
              "truncated"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "forbidden_external_action_detected"
              },
              "changed": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The ref, such as refs/heads/main or refs/remotes/origin/main."
                    },
                    "before": {
                      "description": "The object it pointed at before the attempt; null when it did not exist.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "after": {
                      "description": "The object it pointed at after the attempt; null when it was deleted.",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "before",
                    "after"
                  ],
                  "additionalProperties": false
                },
                "description": "The shared repository's refs that changed while the attempt ran. Only AHP pushes, opens or merges."
              },
              "truncated": {
                "type": "boolean",
                "description": "True when `changed` lists only the first of more."
              }
            },
            "required": [
              "kind",
              "changed",
              "truncated"
            ],
            "additionalProperties": false
          }
        ],
        "description": "One failing part of the verification of the attempt this revision follows."
      },
      "description": "Why the step's last attempt failed, attached by a retry; empty for revision 1. AHP extension."
    },
    "requires": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(?!\\.[gG][iI][tT](?:\\/|$))(?!\\.{1,2}(?:\\/|$))[^/\\\\:*?\"<>|\\u0000-\\u001f]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\:*?\"<>|\\u0000-\\u001f]+)*$",
            "description": "Relative to the repository root, written with forward slashes: no leading or trailing slash, no `.` or `..` segments, nothing under `.git`, and none of the characters \\ : * ? \" < > | or control characters."
          }
        }
      },
      "required": [
        "fields",
        "artifacts"
      ],
      "additionalProperties": false,
      "description": "What the recipient cannot start without; `context` and `artifacts` must cover it."
    }
  },
  "required": [
    "schemaVersion",
    "handoffId",
    "revision",
    "supersedes",
    "contextId",
    "from",
    "to",
    "base",
    "contract",
    "capabilities",
    "network",
    "context",
    "artifacts",
    "evidence",
    "requires"
  ],
  "additionalProperties": false,
  "title": "AHP handoff revision",
  "description": "An immutable revision of a handoff. Rules JSON Schema cannot express: `supersedes` is null for revision 1 and revision - 1 otherwise; revision 1 carries no evidence; paths and field names listed in one array are unique; each capability kind is requested at most once, and `read_only` and `write_scope` are not requested together."
}
